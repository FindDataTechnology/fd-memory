{
  "name": "@finddatatechnology/yongyi-client",
  "version": "0.1.4",
  "type": "module",
  "description": "永忆（YongYi / fd-memory）客户端 SDK：召回注入阶梯、纪律文本单源、五类事实捕获、令牌铸造缓存、/observe 上报。零运行时依赖，只以 fetch 打内核 HTTP 面。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "agent",
    "memory",
    "llm",
    "mcp",
    "working-memory",
    "yongyi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FindDataTechnology/fd-memory.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
