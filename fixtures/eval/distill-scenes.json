  {
    "id": "s01",
    "scene": "A-arc balance triage",
    "expect_keywords": [
      "余额",
      "lane-gw"
    ],
    "sessions": [
      {
        "session_id": "srv-eval-s01",
        "events": [
          {
            "event": "user-prompt-submit",
            "summary": "平台 API 突然 403，帮我查一下是不是余额用尽了"
          },
          {
            "event": "pre-tool-use",
            "tool": "probe_models",
            "summary": "{\"path\":\"/v1/models\",\"max_tokens\":4}"
          },
          {
            "event": "post-tool-use",
            "tool": "probe_models",
            "summary": "200 零花费返回——车道活着"
          },
          {
            "event": "pre-tool-use",
            "tool": "check_balance",
            "summary": "{\"account\":\"platform-test@findmail.com\",\"panel\":\"lane-gw\"}"
          },
          {
            "event": "post-tool-use",
            "tool": "check_balance",
            "summary": "lane-gw 面板显示 INSUFFICIENT_BALANCE，余额 0"
          },
          {
            "event": "stop",
            "summary": "结论：403 是 lane-gw 余额耗尽，充值即恢复；判据=零花费探针 200 + 面板 INSUFFICIENT_BALANCE"
          }
        ]
      }
    ]
  },
