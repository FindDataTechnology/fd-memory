    {
      "name": "declared sub-keys with no consumer are listed as not executed",
      "levels": [
        [
          "project",
          {
            "promote_after": 5,
            "cold_after_days": 90
          }
        ],
        [
          "root",
          {}
        ]
      ],
      "deployment": {},
      "expect": {
        "distill": {
          "declared": null,
          "inherited_from": "platform",
          "effective": "on",
          "executed": true
        },
        "promote_after": {
          "declared": 5,
          "inherited_from": "project",
          "effective": 5,
          "executed": false
